JWT_SECRET=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

DATABASE_URL=postgresql+asyncpg://shilpsetu:secret@localhost:5432/shilpsetu

STORAGE_BACKEND=local          # "local" | "s3" | "gcs"
LOCAL_STORAGE_PATH=./uploads
S3_BUCKET=shilpsetu-assets
S3_REGION=ap-south-1

IMAGE_QUALITY_MIN_SCORE=30     # BRISQUE threshold — reject below this
IMAGE_OUTPUT_FORMAT=webp
ESRGAN_MODEL_PATH=services/image_studio/models/RealESRGAN_x4plus.pth
USE_GPU=false                  # Set true if CUDA GPU is available
